voiceover.evil-chan.ru {
    # Проксируем запросы к Nuxt приложению
    reverse_proxy nuxt:3000

    # WebSocket поддержка для Socket.io
    reverse_proxy /socket.io/* socket:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Логирование
    log {
        output file /var/log/caddy/access.log
        format json
    }

    # Сжатие
    encode gzip

    # Безопасность
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # XSS Protection
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        
        # CSP для WebRTC
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss: ws:; media-src 'self' blob:;"
        
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Обработка ошибок
    handle_errors {
        @404 {
            expression {http.error.status_code} == 404
        }
        rewrite @404 /404.html
        file_server
    }

    @500 {
        expression {http.error.status_code} == 500
    }
    rewrite @500 /500.html
    file_server
}
